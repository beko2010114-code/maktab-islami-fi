image: ubuntu:22.04

stages:
  - build

variables:
  DEBIAN_FRONTEND: noninteractive
  GRADLE_USER_HOME: "$CI_PROJECT_DIR/.gradle"

cache:
  key: gradle-cache
  paths:
    - .gradle/
    - ~/.gradle/caches/
    - ~/.gradle/wrapper/

build_apk:
  stage: build

  before_script:
    - apt-get update -y
    - apt-get install -y unzip wget openjdk-17-jdk findutils
    - java -version

    - wget -q https://services.gradle.org/distributions/gradle-8.7-bin.zip
    - unzip -q gradle-8.7-bin.zip -d /opt
    - export PATH="/opt/gradle-8.7/bin:$PATH"
    - gradle --version

  script:

    # 1. البحث عن ZIP
    - |
      ZIP_FILE=$(find "$CI_PROJECT_DIR" -maxdepth 1 -type f -iname "*.zip" | head -n 1)

      if [ -z "$ZIP_FILE" ]; then
        echo "ERROR: ZIP file not found"
        exit 1
      fi

      echo "ZIP: $ZIP_FILE"

    # 2. فك الضغط
    - |
      rm -rf extracted_project
      mkdir -p extracted_project

      unzip -q "$ZIP_FILE" -d extracted_project

      echo "ZIP extracted successfully"

    # 3. البحث عن مشروع Android
    - |
      echo "Searching for Android project..."

      SETTINGS=$(find extracted_project \
        -type f \
        \( -name "settings.gradle" -o -name "settings.gradle.kts" \) \
        -print -quit)

      BUILD=$(find extracted_project \
        -type f \
        \( -name "build.gradle" -o -name "build.gradle.kts" \) \
        -print -quit)

      if [ -z "$SETTINGS" ] && [ -z "$BUILD" ]; then
        echo "ERROR: Android Gradle project not found"
        echo "Extracted files:"
        find extracted_project -maxdepth 5 -type f | head -300
        exit 1
      fi

      if [ -n "$SETTINGS" ]; then
        PROJECT_DIR=$(dirname "$SETTINGS")
      else
        PROJECT_DIR=$(dirname "$BUILD")
      fi

      echo "Android project:"
      echo "$PROJECT_DIR"

      echo "PROJECT_DIR=$PROJECT_DIR" > project.env

    # 4. فحص المشروع
    - |
      source project.env

      cd "$PROJECT_DIR"

      echo "Project files:"
      ls -la

      echo "Gradle files:"
      find . -maxdepth 2 -type f \
        \( -name "*.gradle" -o -name "*.gradle.kts" \) \
        -print

    # 5. البحث عن مجلد app
    - |
      source project.env

      if [ ! -d "$PROJECT_DIR/app" ]; then
        echo "WARNING: app directory not directly found."

        APP_DIR=$(find "$PROJECT_DIR" \
          -type d \
          -name app \
          -print -quit)

        if [ -z "$APP_DIR" ]; then
          echo "ERROR: Android app module not found"
          exit 1
        fi

        echo "App module found:"
        echo "$APP_DIR"
      fi

    # 6. تجهيز Offline assets
    - |
      source project.env

      mkdir -p "$PROJECT_DIR/app/src/main/assets/data"

      cat > "$PROJECT_DIR/app/src/main/assets/data/BUILD_INFO.txt" <<'EOF'
Maktab Islami 4.7

Offline Islamic Library

Build system:
GitLab CI

Java:
17

Gradle:
8.7

This file is generated during CI.
EOF

    # 7. بناء APK
    - |
      source project.env

      cd "$PROJECT_DIR"

      echo "Starting Gradle build..."

      gradle clean assembleDebug \
        --no-daemon \
        --stacktrace

    # 8. البحث عن APK
    - |
      source project.env

      echo "Searching for APK..."

      find "$PROJECT_DIR" \
        -type f \
        -name "*.apk" \
        -print

      APK=$(find "$PROJECT_DIR" \
        -type f \
        -path "*/build/outputs/apk/*.apk" \
        -print -quit)

      if [ -z "$APK" ]; then
        echo "ERROR: APK was not generated"
        exit 1
      fi

      echo "APK found:"
      ls -lh "$APK"

      mkdir -p artifacts

      cp "$APK" \
        artifacts/Maktab-Islami-4.7-debug.apk

  artifacts:
    name: Maktab-Islami-4.7
    paths:
      - artifacts/Maktab-Islami-4.7-debug.apk
    expire_in: 30 days

  rules:
    - if: '$CI_PIPELINE_SOURCE == "push"'
    - if: '$CI_PIPELINE_SOURCE == "web"'
